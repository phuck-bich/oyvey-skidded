{
  "schemaVersion": 1,
  "id": "oyvey",
  "version": "${version}",
  "name": "Blender Client",
  "description": "Blender Client - a Fabric client for Minecraft 1.21.11",
  "authors": [
    "3arthqu4ke",
    "alpha432",
    "cattyn"
  ],
  "contact": {
    "repo": "https://github.com/cattyngmd/oyvey-portedvey-ported"
  },
  "license": "MIT",
  "environment": "client",
